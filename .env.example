# Copy this file to .env.local, then replace every placeholder.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Use separate random secrets for admin login and Supabase Database Webhooks.
ADMIN_API_TOKEN=replace-with-a-long-random-admin-token
SUPABASE_WEBHOOK_SECRET=replace-with-a-different-long-random-webhook-token

GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-private-key\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_PARENT_FOLDER_ID=your-google-drive-folder-id
